{
  "name": "biodivine-aeon-client",
  "version": "0.5.0",
  "description": "Web client for the AEON Boolean network toolbox.",
  "homepage": "https://github.com/sybila/biodivine-aeon-client#readme",
  "bugs": {
    "url": "https://github.com/sybila/biodivine-aeon-client/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sybila/biodivine-aeon-client.git"
  },
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "landing-page:format:write": "prettier --write ./aeon-landing-page",
    "landing-page:format:check": "prettier --check ./aeon-landing-page",
    "ui:format:write": "prettier --write ./aeon-ui",
    "ui:format:check": "prettier --check ./aeon-ui",
    "wasm:format:check": "cargo fmt --manifest-path ./aeon-wasm/Cargo.toml --check",
    "wasm:format:write": "cargo fmt --manifest-path ./aeon-wasm/Cargo.toml --check",
    "wasm:build:check": "cargo clippy --manifest-path ./aeon-wasm/Cargo.toml",
    "wasm:build:test": "cargo test --manifest-path ./aeon-wasm/Cargo.toml",
    "wasm:build:install": "cd ./aeon-wasm && wasm-pack build --target web"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.1",
    "eslint": "^9.25.1",
    "globals": "^16.0.0",
    "prettier": "3.5.3"
  }
}
